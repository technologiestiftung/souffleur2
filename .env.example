# Vorlage fuer die .env einer Installation. Die echte .env gehoert nicht ins Git.

# --- Rechte --------------------------------------------------------------------
# Nur noetig, wenn das Datenverzeichnis eingehaengt wird (volumes: ./data:/data)
# und nicht dem Benutzer 10001 gehoert. Auf den eigenen setzen: id -u und id -g.
# SOUFFLEUR_USER=1000:1000

# --- Erster Start --------------------------------------------------------------
# Legt das erste Konto an. Nach dem ersten Start beide Zeilen entfernen.
SOUFFLEUR_ADMIN_EMAIL=
SOUFFLEUR_ADMIN_PASSWORD=

# --- Vorfuehrbetrieb -----------------------------------------------------------
# true fuellt eine leere Datenbank aus data/haus.json. Fuer eine Installation,
# in der echte Daten entstehen, bleibt es aus.
# SOUFFLEUR_SEED_DEMO=true

# --- Mehrere Installationen auf einer Maschine --------------------------------
# SOUFFLEUR_IMAGE=souffleur2        # gemeinsames Image mehrerer Installationen
# SOUFFLEUR_INSTANCE=souffleur2     # Name dieses Containers
# SOUFFLEUR_BIND=127.0.0.1:8081
