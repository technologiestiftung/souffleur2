# souffleur im Haus. Diese Datei heisst ".env" und bleibt auf dieser Maschine.

# --- Muss gesetzt sein ---------------------------------------------------------
# Benutzer, dem das Verzeichnis data/ gehoert. Auf der Maschine ablesen
# mit: id -u und id -g. Ohne das kann souffleur seine Datenbank nicht
# schreiben und startet endlos neu.
SOUFFLEUR_USER=1000:1000

# --- Erster Start --------------------------------------------------------------
# Legt das erste Konto an. Nach dem ersten Start beide Zeilen entfernen und
# das Passwort in der Oberflaeche aendern.
SOUFFLEUR_ADMIN_EMAIL=
SOUFFLEUR_ADMIN_PASSWORD=

# --- Erstbefuellung ------------------------------------------------------------
# Mit einer data/haus.json und diesem Schalter legt der erste Start die
# Spielstaetten und einen Spielplan an, damit niemand vor einer leeren
# Oberflaeche sitzt. Wirkt nur auf eine leere Datenbank.
# SOUFFLEUR_SEED_DEMO=true

# --- Erreichbarkeit ------------------------------------------------------------
# Standard: nur auf dieser Maschine. Davor gehoert der Reverse Proxy der
# Synology (oder ein anderer) mit Zertifikat -- siehe README.
#
# Im ganzen Hausnetz, ohne Verschluesselung: SOUFFLEUR_BIND=0.0.0.0:8080
# ⚠️ Diesen Port niemals im Router nach aussen freigeben. Er spricht HTTP;
#    Anmeldungen und Zahlen gingen unverschluesselt durchs Netz.
SOUFFLEUR_BIND=127.0.0.1:8080

# Nur umstellen, wenn souffleur bewusst ohne Reverse Proxy und ohne
# Zertifikat laeuft. Dann gilt das Sitzungscookie auch unverschluesselt --
# und wandert im Klartext durchs Netz.
# SOUFFLEUR_REQUIRE_HTTPS=false

# --- Name ---------------------------------------------------------------------
# Name des Containers. Nur aendern, wenn mehrere Installationen auf derselben
# Maschine laufen.
SOUFFLEUR_INSTANCE=souffleur
